  },
  {
   "from": "L5+2.2",
   "to": "L5+7.0",
   "html": "<div class=\"sub\">stadion, yangi hujumchi, mashg‘ulot bazasi yoki yangi murabbiy?</div>",
   "srt": "stadion, yangi hujumchi, mashg‘ulot bazasi yoki yangi murabbiy?"
  },
  {
