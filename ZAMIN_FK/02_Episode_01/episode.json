 "overlays": [
  {
   "from": "L1+0",
   "to": "L1+2.35",
   "html": "<div class=\"sub\">Bu — Zamin FK stadioni.</div>",
   "srt": "Bu — Zamin FK stadioni."
  },
  {
   "from": "L1+2.6",
   "to": "L1+5.1",
   "html": "<div class=\"sub\">Muxlislar soni... <em>nol.</em></div>",
   "srt": "Muxlislar soni... nol."
  },
  {
   "from": "L1+6.0",
   "to": "L1.end+0.3",
   "html": "<div class=\"sub\">Bitta echkini hisoblamasak.</div>",
   "srt": "Bitta echkini hisoblamasak."
  },
  {
   "from": "L1+2.6",
   "to": "L2+0",
   "html": "<div class=\"badge\"><small>MUXLISLAR</small><b>0</b><i>VIRTUAL</i></div>"
  },
  {
   "from": "L1+6.1",
   "to": "L1.end+0.3",
   "html": "<div class=\"tag\" style=\"left:600px;top:560px\">+1 ECHKI</div>"
  },
  {
   "from": "L2+0",
   "to": "L2+2.9",
   "html": "<div class=\"sub\">Biz — Qoratepadan chiqqan havaskor klubmiz.</div>",
   "srt": "Biz — Qoratepadan chiqqan havaskor klubmiz."
  },
  {
   "from": "L2+3.0",
   "to": "L2+5.2",
   "html": "<div class=\"sub\">Bizda qattiqqo‘l murabbiy bor...</div>",
   "srt": "Bizda qattiqqo‘l murabbiy bor..."
  },
  {
   "from": "L2+5.3",
   "to": "L2+8.0",
   "html": "<div class=\"sub\">o‘zini <em>yulduz</em> deb o‘ylaydigan hujumchi bor...</div>",
   "srt": "o‘zini yulduz deb o‘ylaydigan hujumchi bor..."
  },
  {
   "from": "L2+8.0",
   "to": "L2+11.2",
   "html": "<div class=\"sub\">darvozabonimiz esa qo‘lqopini hali ham qidiryapti.</div>",
   "srt": "darvozabonimiz esa qo‘lqopini hali ham qidiryapti."
  },
  {
   "from": "L2+11.4",
   "to": "L2.end+0.3",
   "html": "<div class=\"sub\">Klub fondida esa atigi <em>15 million so‘m.</em></div>",
   "srt": "Klub fondida esa atigi 15 million so‘m."
  },
  {
   "from": "L2+11.4",
   "to": "L2.end+0.3",
   "html": "<div class=\"card\" style=\"top:560px\"><small>VIRTUAL KLUB FONDI</small><b>15 000 000</b><span>so‘m</span></div>"
  },
  {
   "from": "L3+0",
   "to": "L3+3.2",
   "html": "<div class=\"sub\">Maqsadimiz — eng quyi havaskor ligadan</div>",
   "srt": "Maqsadimiz — eng quyi havaskor ligadan"
  },
  {
   "from": "L3+3.2",
   "to": "L3+6.0",
   "html": "<div class=\"sub\">O‘zbekiston futbolining eng yuqori pog‘onasigacha chiqish.</div>",
   "srt": "O‘zbekiston futbolining eng yuqori pog‘onasigacha chiqish."
  },
  {
   "from": "L3+4.4",
   "to": "L3+6.2",
   "html": "<div class=\"tag\" style=\"left:560px;top:700px\">TO‘P QAYERDA?</div>"
  },
  {
   "from": "L3+6.4",
   "to": "L3.end+0.3",
   "html": "<div class=\"sub\">Ha... hozircha yo‘l <em>uzoq.</em></div>",
   "srt": "Ha... hozircha yo‘l uzoq."
  },
  {
   "from": "L4+0",
   "to": "L4.end+0.3",
   "html": "<div class=\"badge\"><small>MUXLISLAR</small><b>0</b><i>VIRTUAL</i></div>"
  },
  {
   "from": "L4+0",
   "to": "L4+2.0",
   "html": "<div class=\"sub\">Lekin bu yerda <em>SIZ</em> keraksiz!</div>",
   "srt": "Lekin bu yerda SIZ keraksiz!"
  },
  {
   "from": "L4+2.0",
   "to": "L4+5.0",
   "html": "<div class=\"sub\">Har bir obunachi — tribunada bitta virtual muxlis.</div>",
   "srt": "Har bir obunachi — tribunada bitta virtual muxlis."
  },
  {
   "from": "L4+2.0",
   "to": "L4.end+0.3",
   "html": "<div class=\"card\" style=\"top:940px\"><span>1 obunachi = 1 virtual muxlis</span></div>"
  },
  {
   "from": "L4+5.0",
   "to": "L4+7.3",
   "html": "<div class=\"sub\">Har bir layk — klub fondiga bir dollar.</div>",
   "srt": "Har bir layk — klub fondiga bir dollar."
  },
  {
   "from": "L4+5.0",
   "to": "L4.end+0.3",
   "html": "<div class=\"card\" style=\"top:1110px\"><span>1 layk = 1 $ (virtual fond)</span></div>"
  },
  {
   "from": "L4+7.3",
   "to": "L4.end+0.3",
   "html": "<div class=\"sub\">Keling, bu stadionni <em>birga to‘ldiramiz!</em></div>",
   "srt": "Keling, bu stadionni birga to‘ldiramiz!"
  },
  {
   "from": "L5+0",
