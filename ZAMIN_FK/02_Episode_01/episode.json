  },
  {
   "from": "L5+0",
   "to": "L5+2.2",
   "html": "<div class=\"sub\">Birinchi qarorni <em>SIZ</em> qabul qilasiz:</div>",
   "srt": "Birinchi qarorni siz qabul qilasiz:"
  },
  {
   "from": "L5+2.2",
